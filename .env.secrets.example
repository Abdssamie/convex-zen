# --- CI/CD INFRASTRUCTURE SECRETS ---
# Get from: packages/backend -> npx convex deploy-key
CONVEX_DEPLOY_KEY=

# Get from: Cloudflare Dashboard -> My Profile -> API Tokens -> Edit Cloudflare Workers
CLOUDFLARE_API_TOKEN=

# Get from: Cloudflare Dashboard -> Workers & Pages (Right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# --- FRONTEND BUILD VARS ---
# Your production domain (e.g., https://myapp.pages.dev)
SITE_URL=
# Usually the same as SITE_URL
AUTH_TRUSTED_ORIGINS=
# Get from: packages/backend/.env.local (after npx convex dev)
VITE_CONVEX_URL=
# Usually the same as VITE_CONVEX_URL
VITE_CONVEX_SITE_URL=

# --- BACKEND SERVICE SECRETS ---
# Any random long string
BETTER_AUTH_SECRET=
# The email that will have admin access to the directory
ADMIN_EMAIL=

# Brevo (Email)
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
BREVO_APP_NAME="Convex Directory"
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Convex Directory"

# Cloudflare R2 (Storage)
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=convex-directory

# Polar (Payments)
POLAR_ORGANIZATION_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
